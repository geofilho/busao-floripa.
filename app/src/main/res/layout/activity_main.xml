<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/listsTitle"
        style="@style/Heading"
        android:text="Minhas listas" />

    <ScrollView
        android:id="@+id/listsScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/listsBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <TextView
        android:id="@+id/linesTitle"
        style="@style/Heading"
        android:labelFor="@+id/search"
        android:text="Linhas de ônibus" />

    <!-- Logo abaixo do título, para quem percorre a tela do início com o TalkBack encontrar estes botões. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/nearbyStops"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:contentDescription="Localizar pontos de ônibus próximos no Google Maps"
            android:minHeight="56dp"
            android:text="Pontos"
            android:textSize="18sp" />

        <Button
            android:id="@+id/switchMode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:contentDescription="Alternar para transporte intermunicipal"
            android:minHeight="56dp"
            android:text="Intermunicipal"
            android:textSize="18sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/search"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Buscar linha por número ou nome"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:minHeight="56dp"
            android:singleLine="true"
            android:textSize="20sp" />

        <Button
            android:id="@+id/clearSearch"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="Limpar busca"
            android:text="Limpar"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/status"
        style="@style/Body"
        android:accessibilityLiveRegion="polite" />

    <ListView
        android:id="@+id/lines"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
