<resources>
    <style name="AppTheme" parent="android:Theme.Material.Light.DarkActionBar">
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorPrimaryDark">@color/primaryDark</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:buttonStyle">@style/Btn</item>
        <item name="android:alertDialogTheme">@style/Dialog</item>
        <item name="android:textColorHint">@color/hint</item>
    </style>

    <style name="Btn" parent="android:Widget.Material.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">18sp</item>
        <item name="android:minHeight">56dp</item>
    </style>

    <style name="Heading">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>

    <style name="Body">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">18sp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
    </style>

    <style name="Dialog" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:textSize">20sp</item>
        <item name="android:colorAccent">@color/accent_text</item>
        <item name="android:textColorHint">@color/hint</item>
    </style>

    <!-- Alto contraste: usado quando o Android está com Contraste médio ou alto (Android 14 ou mais novo).
         Texto puro sobre fundo puro. -->
    <style name="HighContrast">
        <item name="android:textColorPrimary">#000000</item>
        <item name="android:textColorSecondary">#000000</item>
        <item name="android:textColorHint">#424242</item>
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:colorBackground">#FFFFFF</item>
        <item name="android:colorAccent">#073560</item>
        <item name="android:alertDialogTheme">@style/DialogHighContrast</item>
    </style>

    <style name="DialogHighContrast" parent="Dialog">
        <item name="android:textColorPrimary">#000000</item>
        <item name="android:textColorSecondary">#000000</item>
        <item name="android:textColorHint">#424242</item>
        <item name="android:colorBackground">#FFFFFF</item>
        <item name="android:colorAccent">#073560</item>
    </style>
</resources>
